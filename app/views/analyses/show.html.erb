<div class="container">
  <h1>Analysis Results</h1>
  <p><%= link_to "← New Analysis", new_analysis_path %></p>

  <% polling = !@analysis.done? %>
  <%= turbo_frame_tag "analysis-result",
      src: (polling ? analysis_path(@analysis) : nil),
      data: (polling ? { controller: "poll" } : {}) do %>
    <%= render "result", analysis: @analysis %>
  <% end %>
</div>
