<% if analysis.pending? || analysis.processing? %>
  <div class="status-pending">
    <p>&#9203; <%= analysis.processing? ? "Analyzing your BERA bulletin…" : "Queued for analysis…" %></p>
    <p>This may take 30–60 seconds while the AI reviews the avalanche data and searches for routes.</p>
  </div>

<% elsif analysis.complete? %>
  <div class="status-complete">
    <p>&#10003; Analysis complete (<%= analysis.turns %> turns)</p>
  </div>

  <% if analysis.conditions.present? %>
    <section class="conditions">
      <h2>Conditions</h2>
      <p><%= simple_format(analysis.conditions) %></p>
    </section>
  <% end %>

  <% if analysis.best_skiing.present? %>
    <section class="best-skiing">
      <h2>Where to Ski</h2>
      <p><%= simple_format(analysis.best_skiing) %></p>
    </section>
  <% end %>

  <% if analysis.recommended_routes.any? %>
    <section class="routes">
      <h2>Top Routes</h2>
      <ol>
        <% analysis.recommended_routes.each do |route| %>
          <li>
            <h3>
              <%= link_to route.title, "https://www.camptocamp.org/routes/#{route.camptocamp_route_id}", target: "_blank", rel: "noopener" %>
            </h3>
            <p class="route-meta">
              <% if route.elevation_summit.present? %>Summit <%= route.elevation_summit %> m &middot; <% end %>
              <% if route.orientations.present? %><%= Array(route.orientations).join(", ") %> &middot; <% end %>
              <% if route.difficulty.present? %>Difficulty <%= route.difficulty %><% end %>
            </p>
            <p><%= route.rationale %></p>
          </li>
        <% end %>
      </ol>
    </section>
  <% end %>

<% elsif analysis.failed? %>
  <div class="status-failed">
    <p>&#10007; Analysis failed</p>
    <% if analysis.error_message.present? %>
      <pre class="error-detail"><%= analysis.error_message %></pre>
    <% end %>
  </div>
<% end %>
